          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示模式"
          }
        }
      }
    },
    "Extend": {
      "comment": "Mac settings window and high-resolution quality controls.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Extend"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "扩展屏"
          }
        }
      }
    },
    "Mirror": {
      "comment": "Mac settings window and high-resolution quality controls.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mirror"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "镜像"
          }
        }
      }
    },
    "Quality": {
      "comment": "Mac settings window and high-resolution quality controls.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quality"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "画质"
          }
        }
      }
    },
    "Ultra detail": {
      "comment": "Mac settings window and high-resolution quality controls.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ultra detail"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "超清（高码率）"
          }
        }
      }
    },
    "Best": {
      "comment": "Mac settings window and high-resolution quality controls.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Best"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "清晰（标准码率）"
          }
        }
      }
    },
    "Balanced": {
      "comment": "Mac settings window and high-resolution quality controls.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Balanced"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "均衡"
          }
        }
      }
    },
    "Fast": {
      "comment": "Mac settings window and high-resolution quality controls.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fast"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "流畅"
          }
        }
      }
    },
    "Full resolution with a standard bitrate.": {
      "comment": "Mac settings window and high-resolution quality controls.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Full resolution with a standard bitrate."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保留完整分辨率，使用标准码率。"
          }
        }
      }
    },
    "Lower capture resolution for less latency and bandwidth.": {
      "comment": "Mac settings window and high-resolution quality controls.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lower capture resolution for less latency and bandwidth."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "降低传输分辨率，减少延迟和带宽占用。"
          }
        }
      }
    },
    "Lowest latency and bandwidth, with a softer image. Good for WiFi.": {
      "comment": "Mac settings window and high-resolution quality controls.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lowest latency and bandwidth, with a softer image. Good for WiFi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "优先降低延迟和带宽占用，画面略柔和，适合网络较慢时使用。"
          }
        }
      }
    },
    "Full resolution with a higher adaptive bitrate (24–80 Mbps target). Uses more bandwidth; start with 60 Hz on a stable connection.": {
      "comment": "Mac settings window and high-resolution quality controls.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Full resolution with a higher adaptive bitrate (24–80 Mbps target). Uses more bandwidth; start with 60 Hz on a stable connection."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保留完整分辨率，并提高编码码率（目标 24–80 Mbps）。带宽占用更高，建议先在稳定连接下选择 60 Hz。"
          }
        }
      }
    },
    "Native matches the iPad screen. 2K/4K use a 16:9 HiDPI desktop in Extend mode. Mirror preserves the main screen's detail and aspect ratio without upscaling. The receiver and codec may lower the selected resolution or frame rate.": {
      "comment": "Mac settings window and high-resolution quality controls.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Native matches the iPad screen. 2K/4K use a 16:9 HiDPI desktop in Extend mode. Mirror preserves the main screen's detail and aspect ratio without upscaling. The receiver and codec may lower the selected resolution or frame rate."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原生分辨率匹配 iPad 屏幕。扩展模式下，2K/4K 使用 16:9 高清桌面；镜像模式保持主屏比例，不将低分辨率放大冒充高清。实际分辨率和帧率可能受接收设备与编码能力限制。"
          }
        }
      }
    },
    "Display & picture quality": {
      "comment": "Mac settings window and high-resolution quality controls.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Display & picture quality"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示与画质"
          }
        }
      }
    },
    "For sharper text, start with Native + Ultra detail + 60 Hz. 4K costs more bandwidth and is downsampled on a lower-resolution iPad screen; 4K does not guarantee 120 fps.": {
      "comment": "Mac settings window and high-resolution quality controls.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For sharper text, start with Native + Ultra detail + 60 Hz. 4K costs more bandwidth and is downsampled on a lower-resolution iPad screen; 4K does not guarantee 120 fps."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "想让文字更清晰，可先选择“原生 + 超清 + 60 Hz”。4K 更占带宽，在分辨率较低的 iPad 上仍会缩小显示；4K 不代表能达到 120 帧/秒。"
          }
        }
      }
    },
    "Active streams": {
      "comment": "Mac settings window and high-resolution quality controls.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Active streams"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前连接与传输"
          }
        }
      }
    },
    "No active stream. Preferences apply when a device connects.": {
      "comment": "Mac settings window and high-resolution quality controls.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No active stream. Preferences apply when a device connects."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前没有正在传输的设备。设备连接后会使用这里的设置。"
          }
        }
      }
    },
    "Negotiated dimensions and rate can be lower than your selection. The bitrate target is an encoder budget; live traffic varies with screen content.": {
      "comment": "Mac settings window and high-resolution quality controls.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Negotiated dimensions and rate can be lower than your selection. The bitrate target is an encoder budget; live traffic varies with screen content."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "协商后的分辨率和帧率上限可能低于所选值。目标码率是编码预算；实时流量会随画面内容变化。"
          }
        }
      }
    },
    "Application & display layout": {
      "comment": "Mac settings window and high-resolution quality controls.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
