{
  "sourceLanguage": "en",
  "strings": {
    "Native": {
      "comment": "Display resolution preset: retain the receiver native pixel dimensions.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Native"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原生"
          }
        }
      }
    },
    "Resolution": {
      "comment": "Mac sender: virtual desktop or mirror stream resolution picker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Resolution"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "分辨率"
          }
        }
      }
    },
    "Frame-rate limit": {
      "comment": "Requested maximum streaming frame rate; not measured frame rate.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Frame-rate limit"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "刷新率上限"
          }
        }
      }
    },
    "Low-latency cursor": {
      "comment": "Mac sender: show the cursor independently of encoded video.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Low-latency cursor"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "低延迟光标"
          }
        }
      }
    },
    "The selected rate is limited by receiver, codec and network capabilities. 90/120 Hz is experimental. Mirror resolution changes the stream without changing the main display mode.": {
      "comment": "Explanation below display settings. Keep Hz unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The selected rate is limited by receiver, codec and network capabilities. 90/120 Hz is experimental. Mirror resolution changes the stream without changing the main display mode."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "实际帧率受接收设备、编码和网络能力限制。90/120 Hz 为实验选项。镜像分辨率只改变传输画面，不修改主屏显示模式。"
          }
        }
      }
    },
    "Keyboard & trackpad input": {
      "comment": "iPad receiver toggle for forwarding physical input to the Mac.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keyboard & trackpad input"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "键盘与触控板输入"
          }
        }
      }
    },
    "Input": {
      "comment": "Section heading for hardware keyboard and trackpad controls.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Input"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入"
          }
        }
      }
    },
    "Input goes to your Mac only while this app is streaming in the foreground. Use the keyboard layout and input method selected on your Mac. Some iPadOS system shortcuts stay on the iPad.": {
      "comment": "Hardware input scope, IME ownership and system shortcut limitation.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Input goes to your Mac only while this app is streaming in the foreground. Use the keyboard layout and input method selected on your Mac. Some iPadOS system shortcuts stay on the iPad."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有此应用在前台传输画面时，输入才会发送到 Mac。请使用 Mac 上选择的键盘布局和输入法。部分 iPadOS 系统快捷键仍由 iPad 处理。"
          }
        }
      }
    },
    "Keyboard and trackpad forwarding needs an updated Mac app. Touch input remains available with older Mac apps.": {
      "comment": "Compatibility help when the connected sender lacks the optional hardware-input capability.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keyboard and trackpad forwarding needs an updated Mac app. Touch input remains available with older Mac apps."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "键盘和触控板转发需要更新 Mac 端应用。旧版 Mac 应用仍可接收触摸输入。"
          }
        }
      }
    },
    "Pointer speed": {
      "comment": "Trackpad pointer movement gain. Also used as the slider accessibility label.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pointer speed"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "指针速度"
          }
        }
      }
    },
    "Scroll speed": {
      "comment": "Two-finger scroll gain, independent of pointer speed. Also an accessibility label.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scroll speed"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "滚动速度"
          }
        }
      }
    },
    "Reverse scroll direction": {
      "comment": "Reverse both scroll axes; does not change pointer movement or OS preferences.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reverse scroll direction"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "反转滚动方向"
          }
        }
      }
    },
    "Reset trackpad settings": {
      "comment": "Restore pointer gain, scroll gain and scroll direction to app defaults.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reset trackpad settings"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重置触控板设置"
          }
        }
      }
    },
    "The main display is unavailable.": {
      "comment": "Mirror capture cannot find the main Mac display in ScreenCaptureKit.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The main display is unavailable."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "主显示器当前不可用。"
          }
        }
      }
    },
    "Device": {
      "comment": "Generic receiving device name when the receiver does not identify its kind.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Device"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设备"
          }
        }
      }
    },
    "Extending to %@ (%lld×%lld, %lld fps target)": {
      "comment": "Mac connection status. Arguments: device kind, encoded width, encoded height, requested/negotiated fps. Not measured FPS.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Extending to %@ (%lld×%lld, %lld fps target)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在扩展到 %@（%lld×%lld，目标 %lld fps）"
          }
        }
      }
    },
    "Mirroring to %@ (%lld×%lld, %lld fps target)": {
      "comment": "Mac connection status. Arguments: device kind, encoded width, encoded height, requested/negotiated fps. Not measured FPS.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mirroring to %@ (%lld×%lld, %lld fps target)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在镜像到 %@（%lld×%lld，目标 %lld fps）"
          }
        }
      }
    },
    "Mac shortcut mode": {
      "comment": "iPad receiver optional physical Command/Option swap and shortcut guide. Do not promise interception of iPadOS-reserved shortcuts.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac shortcut mode"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac 快捷键模式"
          }
        }
      }
    },
    "Swap Command and Option only while controlling your Mac. Turn off to restore the usual keys. iPadOS may still reserve its own shortcuts.": {
      "comment": "iPad receiver optional physical Command/Option swap and shortcut guide. Do not promise interception of iPadOS-reserved shortcuts.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Swap Command and Option only while controlling your Mac. Turn off to restore the usual keys. iPadOS may still reserve its own shortcuts."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅在控制 Mac 时交换 Command 和 Option。关闭即可恢复原来的按键。iPadOS 仍可能保留部分系统快捷键。"
          }
        }
      }
    },
    "Use Option instead of Command for Mac shortcuts: Option-Tab switches Mac apps; Option-Space opens Mac search; Option-C/V copies/pastes. Use Command for Mac Option shortcuts. Shift and Control keep their usual roles.": {
      "comment": "iPad receiver optional physical Command/Option swap and shortcut guide. Do not promise interception of iPadOS-reserved shortcuts.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use Option instead of Command for Mac shortcuts: Option-Tab switches Mac apps; Option-Space opens Mac search; Option-C/V copies/pastes. Use Command for Mac Option shortcuts. Shift and Control keep their usual roles."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 Option 代替 Command 操作 Mac：Option-Tab 切换 Mac 应用，Option-空格打开 Mac 搜索，Option-C/V 复制和粘贴。Mac 的 Option 快捷键改用 Command；Shift 和 Control 保持不变。"
          }
        }
      }
    },
    "Settings…": {
      "comment": "Mac settings window and high-resolution quality controls.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Settings…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置…"
          }
        }
      }
    },
    "OpenDisplay Settings": {
      "comment": "Mac settings window and high-resolution quality controls.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenDisplay Settings"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenDisplay 设置"
          }
        }
      }
    },
    "Mode": {
      "comment": "Mac settings window and high-resolution quality controls.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
