    },
    "Opens System Settings → Displays, where you can position the extended displays relative to your Mac screen (Arrange…). Each device shows up as its own display, named after the device.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opens System Settings → Displays, where you can position the extended displays relative to your Mac screen (Arrange…). Each device shows up as its own display, named after the device."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开“系统设置 → 显示器”，调整扩展屏相对于 Mac 屏幕的位置。每台设备会作为一个独立显示器出现。"
          }
        }
      },
      "comment": "OpenDisplay settings and navigation UI. Keep keyboard key names, device names and format placeholders unchanged."
    },
