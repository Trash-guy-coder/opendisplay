        }
      },
      "comment": "OpenDisplay settings and navigation UI. Keep keyboard key names, device names and format placeholders unchanged."
    },
    "Required for WiFi mode. If no device appears in the Devices list, allow OpenDisplay under Privacy & Security → Local Network on this Mac AND on the device — and keep the OpenDisplay app open there.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Required for WiFi mode. If no device appears in the Devices list, allow OpenDisplay under Privacy & Security → Local Network on this Mac AND on the device — and keep the OpenDisplay app open there."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "WiFi 连接需要此权限。若未发现设备，请在 Mac 和接收设备的“隐私与安全性 → 本地网络”中允许 OpenDisplay，并保持接收端应用打开。"
          }
        }
      },
      "comment": "OpenDisplay settings and navigation UI. Keep keyboard key names, device names and format placeholders unchanged."
    },
