    "No menu bar or Dock icon — streaming keeps running. Open the OpenDisplay app again (Spotlight/Finder) to show this window.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No menu bar or Dock icon — streaming keeps running. Open the OpenDisplay app again (Spotlight/Finder) to show this window."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "隐藏菜单栏和程序坞图标，画面传输继续运行。通过聚焦搜索或访达再次打开应用，即可显示此窗口。"
          }
        }
      },
      "comment": "OpenDisplay settings and navigation UI. Keep keyboard key names, device names and format placeholders unchanged."
    },
