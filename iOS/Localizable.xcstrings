    },
    "OpenDisplay turns this %@ into a second screen for your Mac — but it needs the **OpenDisplay Mac app** running on a Mac connected by the same USB cable or on the same WiFi network.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenDisplay turns this %@ into a second screen for your Mac — but it needs the **OpenDisplay Mac app** running on a Mac connected by the same USB cable or on the same WiFi network."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenDisplay 可将这台 %@ 用作 Mac 的第二块屏幕。请先在 Mac 上运行 **OpenDisplay Mac 端应用**，再通过 USB 数据线或同一 WiFi 网络连接。"
          }
        }
      }
    },
    "Install the OpenDisplay Mac app on your Mac": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Install the OpenDisplay Mac app on your Mac"
