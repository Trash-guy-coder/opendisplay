    "Shown in the Mac app's WiFi connection menu. iOS hides this %@'s real name from apps, so set it here once.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shown in the Mac app's WiFi connection menu. iOS hides this %@'s real name from apps, so set it here once."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此名称会显示在 Mac 应用的 WiFi 连接菜单中。由于系统不向应用提供这台 %@ 的真实名称，请在这里设置。"
          }
        }
      }
    },
    "Performance overlay": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Performance overlay"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示性能信息"
          }
        }
      }
    },
    "Metal renderer (experimental)": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Metal renderer (experimental)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Metal 渲染器（实验功能）"
          }
        }
      }
    },
    "Analytics": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Analytics"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "性能显示"
          }
        }
      }
    },
    "The overlay shows FPS, bitrate, frame timing, stalls, and latency graphs at the bottom of the screen while streaming. The experimental Metal renderer decodes and presents frames manually — it adds decode and true on-glass latency metrics to the overlay, but in our measurements the system video layer displays frames faster. Leave it off unless you're debugging.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The overlay shows FPS, bitrate, frame timing, stalls, and latency graphs at the bottom of the screen while streaming. The experimental Metal renderer decodes and presents frames manually — it adds decode and true on-glass latency metrics to the overlay, but in our measurements the system video layer displays frames faster. Leave it off unless you're debugging."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开启后，画面底部会显示帧率、码率、卡顿和延迟等信息。实验性 Metal 渲染器可提供更多解码与显示延迟数据，但目前测得的系统默认渲染更快，日常使用建议关闭 Metal 渲染器。"
          }
        }
      }
    },
    "Open iOS Settings for OpenDisplay": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open iOS Settings for OpenDisplay"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开 OpenDisplay 的系统设置"
          }
        }
      }
    },
    "Permissions": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Permissions"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "权限"
          }
        }
      }
    },
    "WiFi mode needs Local Network access. If your Mac can't find this %@, enable it under Settings → Privacy & Security → Local Network → OpenDisplay. USB mode works without it.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "WiFi mode needs Local Network access. If your Mac can't find this %@, enable it under Settings → Privacy & Security → Local Network → OpenDisplay. USB mode works without it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "WiFi 连接需要“本地网络”权限。如果 Mac 找不到这台 %@，请前往“设置 → 隐私与安全性 → 本地网络 → OpenDisplay”开启权限。USB 连接不需要此权限。"
          }
        }
      }
    },
    "Connection log": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connection log"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接日志"
          }
        }
      }
    },
    "Diagnostics": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Diagnostics"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "故障排查"
          }
        }
      }
    },
    "What this %@ saw while connecting: sessions, restarts, decoder trouble. No screen content and nothing leaves the %@ unless you share it. Attach it to a GitHub issue if a connection won't come up.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What this %@ saw while connecting: sessions, restarts, decoder trouble. No screen content and nothing leaves the %@ unless you share it. Attach it to a GitHub issue if a connection won't come up."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "记录这台 %@ 的连接、重启和解码异常，不包含屏幕内容。日志保留在 %@ 上，只有主动分享才会导出。连接失败时可将日志附在 GitHub 问题反馈中。"
          }
        }
      }
    },
    "USB: plug in the cable, run the Mac app — it connects automatically through the wire (lowest latency).": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "USB: plug in the cable, run the Mac app — it connects automatically through the wire (lowest latency)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "USB：连接数据线并运行 Mac 端应用，即可自动连接，延迟通常更低。"
          }
        }
      }
    },
    "WiFi: both devices on the same network, then pick this %@ in the Mac app's Connection menu.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "WiFi: both devices on the same network, then pick this %@ in the Mac app's Connection menu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "WiFi：两台设备接入同一网络，然后在 Mac 应用的“连接”菜单中选择这台 %@。"
          }
        }
      }
    },
    "Rotate the %@ for a vertical second monitor.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rotate the %@ for a vertical second monitor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "旋转 %@ 即可将其用作竖向副屏。"
          }
        }
      }
    },
    "Touch: tap to click, drag to drag, two-finger pan to scroll.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Touch: tap to click, drag to drag, two-finger pan to scroll."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "触屏操作：轻点执行点击，滑动执行拖动，双指滑动滚动页面。"
          }
        }
      }
    },
    "How to connect": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
